{
  "customSyntax": "postcss-scss",
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "declaration-property-value-disallowed-list": {
      "/^(color|background|background-color|border|border-color|outline|fill|stroke)$/": [
        "/^rgb\\(/",
        "/^rgba\\(/",
        "/^hsl\\(/",
        "/^hsla\\(/"
      ]
    }
  }
}
